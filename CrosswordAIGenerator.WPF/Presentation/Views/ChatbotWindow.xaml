<Window x:Class="CrosswordAIGenerator.WPF.Presentation.Views.ChatbotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:CrosswordAIGenerator.Core.Domain.Models;assembly=CrosswordAIGenerator.Core"
        xmlns:converters="clr-namespace:CrosswordAIGenerator.WPF.Converters"
        mc:Ignorable="d"
        Title="Chatbot Bielika 4.5B v3" Height="700" Width="1000">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <converters:ChatbotModeToBooleanConverter x:Key="ChatbotModeToBooleanConverter"/>
        
        <!-- Konwertery string -->
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>
        
        <!-- Konwertery kolorów -->
        <converters:BooleanToBrushConverter x:Key="UserMessageBackgroundConverter">
            <converters:BooleanToBrushConverter.TrueValue>
                <SolidColorBrush Color="#E3F2FD"/>
            </converters:BooleanToBrushConverter.TrueValue>
            <converters:BooleanToBrushConverter.FalseValue>
                <SolidColorBrush Color="#F5F5F5"/>
            </converters:BooleanToBrushConverter.FalseValue>
        </converters:BooleanToBrushConverter>
        
        <converters:BooleanToBrushConverter x:Key="UserMessageForegroundConverter">
            <converters:BooleanToBrushConverter.TrueValue>
                <SolidColorBrush Color="#1976D2"/>
            </converters:BooleanToBrushConverter.TrueValue>
            <converters:BooleanToBrushConverter.FalseValue>
                <SolidColorBrush Color="#212121"/>
            </converters:BooleanToBrushConverter.FalseValue>
        </converters:BooleanToBrushConverter>
        
        <!-- DataTemplate dla wiadomości -->
        <DataTemplate x:Key="ChatMessageTemplate">
            <Border Margin="5" Padding="10" CornerRadius="5"
                    Background="{Binding IsUser, Converter={StaticResource UserMessageBackgroundConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" 
                               FontSize="10" Foreground="Gray" Margin="0,0,0,5"/>
                    
                    <!-- Obraz krzyżówki (jeśli istnieje) -->
                    <Image Source="{Binding ImagePath, Converter={StaticResource StringToImageSourceConverter}}" 
                           MaxWidth="600"
                           MaxHeight="600"
                           Stretch="Uniform"
                           Margin="0,0,0,10"
                           Visibility="{Binding ImagePath, Converter={StaticResource StringToVisibilityConverter}}"/>
                    
                    <!-- Tekst odpowiedzi -->
                    <TextBlock Text="{Binding Content}" 
                               TextWrapping="Wrap" 
                               FontSize="13"
                               Foreground="{Binding IsUser, Converter={StaticResource UserMessageForegroundConverter}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Panel kontrolny -->
        <GroupBox Grid.Row="0" Header="Ustawienia" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Pierwszy rząd: Tryb i Model -->
                <Label Grid.Row="0" Grid.Column="0" Content="Tryb:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Grid.Row="0" Grid.Column="1" 
                          SelectedValue="{Binding SelectedMode}"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0">
                    <ComboBox.ItemsSource>
                        <x:Array Type="models:ChatbotMode" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                            <models:ChatbotMode>General</models:ChatbotMode>
                            <models:ChatbotMode>Crossword</models:ChatbotMode>
                        </x:Array>
                    </ComboBox.ItemsSource>
                </ComboBox>
                
                <Label Grid.Row="0" Grid.Column="2" Content="Model:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <ComboBox Grid.Row="0" Grid.Column="3" 
                          SelectedValue="{Binding SelectedCrosswordModel}"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"
                          IsEnabled="{Binding SelectedMode, Converter={StaticResource ChatbotModeToBooleanConverter}}">
                    <ComboBox.ItemsSource>
                        <x:Array Type="models:CrosswordModel" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                            <models:CrosswordModel>Bielik</models:CrosswordModel>
                            <models:CrosswordModel>Qwen</models:CrosswordModel>
                        </x:Array>
                    </ComboBox.ItemsSource>
                </ComboBox>
                
                <!-- Drugi rząd: Przyciski i status -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,10,0">
                    <Button Content="Sprawdź status" 
                            Command="{Binding CheckServerStatusCommand}"
                            Padding="10,5"
                            Margin="0,0,5,0"/>
                    <Button Content="Załaduj adapter" 
                            Command="{Binding LoadCrosswordAdapterCommand}"
                            Padding="10,5"/>
                </StackPanel>
                
                <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4"
                           Text="{Binding ServerStatusMessage}" 
                           VerticalAlignment="Center"
                           Margin="10,10,0,0"
                           FontWeight="Bold"/>
            </Grid>
        </GroupBox>
        
        <!-- Historia rozmowy -->
        <GroupBox Grid.Row="1" Header="Rozmowa">
            <ScrollViewer x:Name="MessagesScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="MessagesScrollViewer_ScrollChanged">
                <ItemsControl ItemsSource="{Binding Messages}"
                              ItemTemplate="{StaticResource ChatMessageTemplate}"
                              Background="White">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="5,0"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
        
        <!-- Panel wprowadzania -->
        <GroupBox Grid.Row="2" Header="Wiadomość" Margin="0,10,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBox Grid.Row="0"
                         Text="{Binding CurrentPrompt, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="60"
                         MaxHeight="120"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="13"
                         KeyDown="PromptTextBox_KeyDown"/>
                
                <StackPanel Grid.Row="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            Margin="0,10,0,0">
                    <Button Content="Wyślij" 
                            Command="{Binding SendMessageCommand}"
                            Padding="15,5"
                            Margin="0,0,10,0"
                            IsDefault="True"/>
                    <Button Content="Anuluj" 
                            Command="{Binding CancelGenerationCommand}"
                            Padding="15,5"
                            Margin="0,0,10,0"
                            IsEnabled="{Binding IsLoading}"/>
                    <Button Content="Wyczyść" 
                            Command="{Binding ClearChatCommand}"
                            Padding="15,5"/>
                </StackPanel>
            </Grid>
        </GroupBox>
        
        <!-- Progress indicator -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <ProgressBar IsIndeterminate="True" 
                         Height="20"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
        
        <!-- Status bar -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Status: "/>
                    <Run Text="{Binding ServerStatusMessage}" FontWeight="Bold"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock>
                    <Run Text="Wiadomości: "/>
                    <Run Text="{Binding Messages.Count, Mode=OneWay}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

