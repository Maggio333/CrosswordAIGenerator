<UserControl x:Class="CrosswordAIGenerator.WPF.Presentation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <TextBlock Grid.Row="0" 
                   Text="Ustawienia datasetów" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Margin="0,0,0,10"/>

        <!-- Checkboxy -->
        <GroupBox Grid.Row="1" Header="Elementy datasetu" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <CheckBox Content="Zawieraj XAML (pełna wersja z literami)" 
                          IsChecked="{Binding IncludeXaml}"/>
                <CheckBox Content="Zawieraj pustą wersję XAML (bez liter, tylko ramki)" 
                          IsChecked="{Binding IncludeEmptyXaml}" 
                          Margin="0,5,0,0"/>
                <CheckBox Content="Zawieraj CrossGrid (format ASCII art)" 
                          IsChecked="{Binding IncludeCrossGrid}" 
                          Margin="0,5,0,0"/>
                <CheckBox Content="Zawieraj screenshot (obraz JPG)" 
                          IsChecked="{Binding IncludeScreenshot}" 
                          Margin="0,5,0,0"/>
                <CheckBox Content="Zawieraj opis tekstowy" 
                          IsChecked="{Binding IncludeDescription}" 
                          Margin="0,5,0,0"/>
                <CheckBox Content="Zawieraj SearchableText (tekst do wyszukiwania)" 
                          IsChecked="{Binding IncludeSearchableText}" 
                          Margin="0,5,0,0"/>
                <CheckBox Content="Zawieraj EmbeddingText (tekst do embeddingu dla RAG)" 
                          IsChecked="{Binding IncludeEmbeddingText}" 
                          Margin="0,5,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Informacja -->
        <TextBlock Grid.Row="2" 
                   Text="Ustawienia są automatycznie zapisywane po każdej zmianie." 
                   FontStyle="Italic" 
                   Foreground="Gray" 
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>

