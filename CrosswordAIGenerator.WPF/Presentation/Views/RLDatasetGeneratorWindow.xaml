<Window x:Class="CrosswordAIGenerator.WPF.Presentation.Views.RLDatasetGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:CrosswordAIGenerator.WPF.Presentation.ViewModels"
        xmlns:rl="clr-namespace:CrosswordAIGenerator.Core.Domain.Models.RL;assembly=CrosswordAIGenerator.Core"
        mc:Ignorable="d"
        Title="RL Dataset Generator" Height="800" Width="1400">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Panel Kontrolny -->
        <GroupBox Grid.Row="0" Header="Panel Kontrolny" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Rozmiar siatki -->
                <Label Grid.Column="0" Content="Rozmiar:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBox Text="{Binding GridSizeRows, UpdateSourceTrigger=PropertyChanged}" 
                             Width="50" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <Label Content="x" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding GridSizeColumns, UpdateSourceTrigger=PropertyChanged}" 
                             Width="50" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Liczba słów -->
                <Label Grid.Column="2" Content="Słowa:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <TextBox Grid.Column="3" Text="{Binding WordCount, UpdateSourceTrigger=PropertyChanged}" 
                         Width="60" VerticalAlignment="Center"/>

                <!-- Liczba wpisów -->
                <Label Grid.Column="4" Content="Wpisy:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <TextBox Grid.Column="5" Text="{Binding EntryCount, UpdateSourceTrigger=PropertyChanged}" 
                         Width="60" VerticalAlignment="Center"/>

                <!-- Strategia -->
                <Label Grid.Column="6" Content="Strategia:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <ComboBox Grid.Column="7" 
                          SelectedValue="{Binding SelectedStrategy}"
                          VerticalAlignment="Center">
                    <ComboBox.ItemsSource>
                        <x:Array Type="rl:SelfPlayStrategy" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                            <rl:SelfPlayStrategy>Random</rl:SelfPlayStrategy>
                            <rl:SelfPlayStrategy>Greedy</rl:SelfPlayStrategy>
                        </x:Array>
                    </ComboBox.ItemsSource>
                </ComboBox>

                <!-- Przyciski - Wiersz 1 -->
                <Button Grid.Column="0" Grid.Row="1" Content="Generuj Dataset RL" 
                        Command="{Binding GenerateRLDatasetCommand}" 
                        Margin="0,10,5,0" Padding="10,5">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="1" Grid.Row="1" Content="Eksport JSONL (RL)" 
                        Command="{Binding ExportToJsonlCommand}" 
                        Margin="5,10,5,0" Padding="10,5"/>
                <Button Grid.Column="2" Grid.Row="1" Content="Eksport do Treningu" 
                        Command="{Binding ExportForTrainingCommand}" 
                        Margin="5,10,5,0" Padding="10,5"
                        ToolTip="Eksport w formacie Supervised (BC) lub RL (PPO)"/>
                <Button Grid.Column="3" Grid.Row="1" Content="Statystyki" 
                        Command="{Binding ShowStatisticsCommand}" 
                        Margin="5,10,5,0" Padding="10,5"
                        ToolTip="Pokaż statystyki datasetu"/>
                <Button Grid.Column="4" Grid.Row="1" Content="Wyczyść" 
                        Command="{Binding ClearDataCommand}" 
                        Margin="5,10,0,0" Padding="10,5"/>
            </Grid>
        </GroupBox>

        <!-- Główny obszar: Lista wpisów i szczegóły -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista wpisów RL -->
            <GroupBox Grid.Column="0" Header="Wpisy RL">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding RlEntries.Count, StringFormat='Liczba: {0}'}" 
                               Margin="5" FontWeight="Bold"/>
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding RlEntries}"
                             SelectedItem="{Binding SelectedRLEntry}"
                             Margin="5">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" Margin="2">
                                    <TextBlock Text="{Binding Action.Word, StringFormat='Słowo: {0}'}" FontWeight="Bold" FontSize="10"/>
                                    <TextBlock Text="{Binding Action, StringFormat='Akcja: {0}'}" FontSize="9" Foreground="Gray"/>
                                    <TextBlock Text="{Binding Reward, StringFormat='Nagroda: {0:F2}'}" FontSize="9" Foreground="DarkBlue"/>
                                    <TextBlock Text="{Binding IsTerminal, StringFormat='Terminal: {0}'}" FontSize="9" Foreground="DarkGreen"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <!-- Szczegóły wybranego wpisu -->
            <GroupBox Grid.Column="2" Header="Szczegóły wpisu">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding SelectedEntryDetails, Mode=OneWay}" 
                             IsReadOnly="True" 
                             FontFamily="Consolas" 
                             FontSize="11"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Status: "/>
                    <Run Text="{Binding StatusMessage}" FontWeight="Bold"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Wygenerowano: "/>
                    <Run Text="{Binding GeneratedCount}" FontWeight="Bold"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding EntryCount}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Rozmiar siatki: "/>
                    <Run Text="{Binding GridSizeRows}"/>
                    <Run Text="x"/>
                    <Run Text="{Binding GridSizeColumns}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Strategia: "/>
                    <Run Text="{Binding SelectedStrategy}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
