<UserControl x:Class="CrosswordAIGenerator.WPF.Presentation.Views.CustomWordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:CrosswordAIGenerator.WPF.Presentation.Views"
             xmlns:converters="clr-namespace:CrosswordAIGenerator.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1200">
    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Panel wprowadzania danych -->
        <GroupBox Grid.Row="0" Header="Wprowadź słowa i definicje" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Lewa kolumna: Hasło i lista słów -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                    <Label Content="Hasło główne:" FontWeight="Bold"/>
                    <TextBox Text="{Binding HighlightedWord, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="16" Padding="5" Margin="0,5,0,10"
                             ToolTip="Wprowadź hasło główne (np. DZIECKO)"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Button Content="Wczytaj przykład" Command="{Binding LoadExampleDataCommand}" 
                                Padding="10,5" Margin="0,0,5,0"
                                Click="LoadExampleDataButton_Click"/>
                        <Button Content="Dodaj słowo" Command="{Binding AddWordCommand}" 
                                Padding="10,5"
                                Click="AddWordButton_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Prawa kolumna: Rozmiar siatki i przyciski -->
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <Label Content="Rozmiar siatki:" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                        <TextBox Text="{Binding GridSizeRows, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="50" Margin="0,0,5,0"/>
                        <Label Content="x" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Text="{Binding GridSizeColumns, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="50"/>
                    </StackPanel>
                    
                    <Label Content="Min. liczba słów:" FontWeight="Bold" Margin="0,5,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                        <TextBox Text="{Binding MinWordsCount, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="50" Margin="0,0,5,0"
                                 ToolTip="0 = wszystkie słowa (długość hasła), lub wybierz mniejszą liczbę"/>
                        <Label Content="/" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Label Content="{Binding MaxWordsCount}" VerticalAlignment="Center" 
                               FontWeight="Bold" Margin="0,0,5,0"/>
                        <TextBlock Text="(długość hasła)" FontSize="10" Foreground="Gray" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Button Content="Generuj Pojedynczy" Command="{Binding GenerateSingleCommand}" 
                                    Padding="10,5" Margin="0,0,5,0"
                                    Click="GenerateSingleButton_Click"
                                    IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBooleanConverter}}">
                            </Button>
                            <Button Content="Generuj Dataset" Command="{Binding GenerateDatasetCommand}" 
                                    Padding="10,5" Margin="0,0,5,0"
                                    Click="GenerateDatasetButton_Click"
                                    IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBooleanConverter}}">
                            </Button>
                            <Label Content="Ilość:" VerticalAlignment="Center" Margin="5,0,5,0"/>
                            <TextBox Text="{Binding DatasetCount, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="60" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Button Content="Eksportuj do JSON" Command="{Binding ExportToJsonCommand}" 
                                    Padding="10,5" Margin="0,0,5,0"
                                    ToolTip="Zapisz wygenerowany dataset do pliku JSON"/>
                            <Button Content="Wyczyść" Command="{Binding ClearDataCommand}" 
                                    Padding="10,5"
                                    ToolTip="Wyczyść wygenerowane dane"/>
                        </StackPanel>
                </StackPanel>

                <!-- Lista słów i definicji -->
                <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Header="Słowa i definicje" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="{Binding Words.Count, StringFormat='Liczba słów: {0}'}" 
                                   Margin="5" FontWeight="Bold"/>
                        
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Words}" Margin="5">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="LightGray" BorderThickness="1" 
                                                Margin="0,5" Padding="10" Background="WhiteSmoke">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <Label Grid.Row="0" Grid.Column="0" 
                                                       Content="{Binding Index, StringFormat='{}{0}.'}" 
                                                       FontWeight="Bold" FontSize="14" 
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                
                                                <TextBox Grid.Row="0" Grid.Column="1" 
                                                         Text="{Binding Word, UpdateSourceTrigger=PropertyChanged}" 
                                                         FontSize="14" FontWeight="Bold" Padding="5"
                                                         Margin="0,0,10,5"
                                                         ToolTip="Wprowadź słowo"/>
                                                
                                                <Button Grid.Row="0" Grid.Column="2" 
                                                        Content="Usuń" 
                                                        Click="RemoveWordButton_Click"
                                                        Tag="{Binding}"
                                                        Padding="5,2" Margin="0,0,0,5"/>
                                                
                                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                         Text="{Binding Definition, UpdateSourceTrigger=PropertyChanged}" 
                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                         MinHeight="40" Padding="5"
                                                         ToolTip="Wprowadź definicję"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </GroupBox>
            </Grid>
        </GroupBox>

        <!-- Główny obszar: Informacja i XAML Preview -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Informacja o wyświetlaniu -->
            <GroupBox Grid.Column="0" Header="Informacja">
                <StackPanel Margin="10" VerticalAlignment="Center">
                    <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,10">
                        <Run Text="Krzyżówki generowane w tej zakładce będą wyświetlane na zakładce " FontWeight="Normal"/>
                        <Run Text="'Automatyczne'" FontWeight="Bold"/>
                        <Run Text="." FontWeight="Normal"/>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,10" Foreground="Gray">
                        <Run Text="Po wygenerowaniu krzyżówki przełącz się na zakładkę 'Automatyczne', aby zobaczyć wynik."/>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <!-- XAML Preview -->
            <GroupBox Grid.Column="2" Header="XAML Preview">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding XamlText, Mode=OneWay}" 
                             IsReadOnly="True" 
                             FontFamily="Consolas" 
                             FontSize="11"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Status: "/>
                    <Run Text="{Binding StatusMessage}" FontWeight="Bold"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Wygenerowano: "/>
                    <Run Text="{Binding GeneratedCount}" FontWeight="Bold"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding DatasetCount}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="W kolekcji: "/>
                    <Run Text="{Binding DatasetEntries.Count, Mode=OneWay}" FontWeight="Bold"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Rozmiar siatki: "/>
                    <Run Text="{Binding GridSizeRows}"/>
                    <Run Text="x"/>
                    <Run Text="{Binding GridSizeColumns}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>

