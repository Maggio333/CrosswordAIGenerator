<Window x:Class="CrosswordAIGenerator.WPF.Presentation.Views.CrossGridPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CrosswordAIGenerator.WPF.Presentation.Views"
        xmlns:converters="clr-namespace:CrosswordAIGenerator.WPF.Converters"
        mc:Ignorable="d"
        Title="Podgląd CrossGrid" Height="800" Width="1400">
    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <TextBlock Grid.Row="0" Text="Wklej kod CrossGrid i kliknij 'Konwertuj do XAML'" 
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Pole tekstowe dla CrossGrid -->
        <GroupBox Grid.Row="1" Header="CrossGrid (wklej tutaj)">
            <TextBox Text="{Binding CrossGridText, UpdateSourceTrigger=PropertyChanged}" 
                     AcceptsReturn="True" 
                     TextWrapping="Wrap" 
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="12"/>
        </GroupBox>

        <!-- Przyciski -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
            <Button Content="Konwertuj do XAML" 
                    Command="{Binding ConvertToXamlCommand}" 
                    Padding="10,5" 
                    Margin="0,0,10,0"
                    IsEnabled="{Binding IsValidating, Converter={StaticResource InverseBooleanConverter}}"/>
            <Button Content="Wyczyść" 
                    Command="{Binding ClearCommand}" 
                    Padding="10,5"/>
        </StackPanel>

        <!-- Panel z wynikiem -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Wygenerowany XAML -->
            <GroupBox Grid.Column="0" Header="Wygenerowany XAML">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding GeneratedXaml}" 
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="10"
                             TextWrapping="NoWrap"/>
                </ScrollViewer>
            </GroupBox>

            <!-- Podgląd krzyżówki -->
            <GroupBox Grid.Column="2" Header="Podgląd krzyżówki">
                <views:CrosswordView x:Name="CrosswordViewControl"/>
            </GroupBox>
        </Grid>

        <!-- Status i walidacja -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding ValidationMessage}" 
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Window>

